# 복사해서 .env 로 쓴다 (.env 는 gitignore 대상). 실행: uv run --env-file .env uvicorn --factory stage_director.api:create_app
# Next.js 가 X-Internal-Key 헤더로 보내는 값과 같아야 한다. 서버 환경변수에만 둔다.
INTERNAL_API_KEY=
GEMINI_API_KEY=
DATABASE_URL=postgresql://stage_director:stage_director@localhost:5433/stage_director_checkpoints
# 비우면 stage_director/settings.py 의 DEFAULT_GEMINI_MODEL
GEMINI_MODEL=
# 주 모델이 실패(503 혼잡 등)하면 한 번 더 시도할 모델. 비우면 settings.py 의 DEFAULT_GEMINI_FALLBACK_MODEL, 주 모델과 같게 두면 끈다
GEMINI_FALLBACK_MODEL=
# 모델당 분당 요청 수 상한(슬라이딩 윈도우). 비우면 settings.py 의 DEFAULT_GEMINI_RPM(4: 무료 키 한도가 모델당 분당 5회라서). 유료 키면 여기서 올린다. 0 이면 제한하지 않는다
GEMINI_RPM=
# 음원 URL(무드 해석·분석 작업)로 받을 호스트 허용 목록. 쉼표 구분, 접미사 일치(abc.supabase.co 는 supabase.co 에 걸린다).
# 비우면 공인 IP 검사만 한다. 운영에서는 Supabase 프로젝트 호스트를 반드시 넣는다
AUDIO_URL_ALLOWED_HOSTS=
